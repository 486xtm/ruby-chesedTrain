%div{ class: "lg:bg-primary text-white w-full transition-all duration-300  font-alice h-[100px]" }
  .lg:flex.lg:flex-row.items-center.justify-between.hidden.pr-12 
    .logo
      = image_tag "/imgs/logo_h.png", class: "h-[100px]", alt: "Header Logo"
    %div{ class: "text-secondary xl:text-[3rem] text-[2rem] text-center absolute left-0 right-0 mx-auto"} CHESED TRAIN
    .flex.flex-row.items-center.justify-center.space-x-4
      %button{ class: "bg-transparent text-secondary xl:w-[9.45rem] w-[7rem] text-[0.7rem] text-center py-2 rounded-[0.7rem] cursor-pointer border border-secondary"} Sign In
      %button{ class: "bg-primary-original text-white xl:w-[11.5rem] w-[9rem] text-[0.7rem] text-center py-2 rounded-[0.7rem] cursor-pointer border border-secondary"} Start a Chesed Train
      %span{ class: "text-secondary text-[0.9rem]"} ב״ה
  .lg:hidden.flex.flex-row.items-center.justify-between
    .flex.flex-row.items-center.justify-center
      %span{ class: "text-secondary text-[1rem] w-[4rem] text-center"} ב״ה
    .logo
      = image_tag "/imgs/logo_h.png", class: "h-[100px]", alt: "Header Logo"
    %button.relative#mobile-menu-button{onclick: "toggleMenu()", class: "h-[100px] flex items-center"}
      = image_tag "/icons/menu.svg", class: "h-[100px]", alt: "Menu", id: "menu-icon"
    #mobile-menu{class: "hidden absolute top-[100px] right-0 w-full bg-white shadow-lg z-50"}
      .flex.flex-col.items-center.py-4.space-y-4
        = link_to "Homepage", "#", class: "text-secondary font-lato font_large items-center justify-center flex h-[3rem] w-[17.5rem] text-center hover:bg-[rgba(63,114,175,0.2)] hover:text-gray-900"
        = link_to "Login", "#", class: "text-secondary font-lato font_large items-center justify-center flex h-[3rem] w-[17.5rem] text-center hover:bg-[rgba(63,114,175,0.2)] hover:text-gray-900"
        = link_to "Start A Chesed Train", "#", class: "text-secondary font-lato font_large items-center justify-center flex h-[3rem] w-[17.5rem] text-center hover:bg-[rgba(63,114,175,0.2)] hover:text-gray-900"
    :javascript
      function toggleMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      menu.classList.toggle('hidden');
      if (menu.classList.contains('hidden')) {
      menuIcon.src = '/icons/menu.svg';
      } else {
      menuIcon.src = '/icons/menu_close.svg';
      }
      }
