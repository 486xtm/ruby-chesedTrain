%footer.fixed.bottom-0.w-full.bg-gray-100.py-4
  .container.mx-auto
    .flex.flex-col.items-center.justify-center.space-y-4
      .logo
        = image_tag "logo.png", class: "h-8", alt: "Chesed Train Logo"
      
      .links.flex.space-x-4.text-sm.text-gray-600
        = link_to "About Us", "#", class: "hover:text-gray-900"
        = link_to "Contact Us", "#", class: "hover:text-gray-900"
        = link_to "Chesed Train Pro", "#", class: "hover:text-gray-900"
      
      .links.flex.space-x-4.text-sm.text-gray-600
        = link_to "Privacy Policy", "#", class: "hover:text-gray-900"
        = link_to "Potluck", "#", class: "hover:text-gray-900"
        = link_to "Terms of Service", "#", class: "hover:text-gray-900" 